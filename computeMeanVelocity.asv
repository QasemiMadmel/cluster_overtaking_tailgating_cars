function [v_mean, vx_mean, vy_mean] = computeMeanVelocity(vx, vy, t)

    timestamps = unique(t);
    numScans = length(timestamps);

    v_mean = zeros(numScans,1);
    vx_mean = zeros(numScans, 1);
    vy_mean = zeros(numScans, 1);

    for i = 1:numScans
        
        idx = (t == timestamps(i)); 

        vx_scan = vx(idx);
        vy_scan = vy(idx);

        vx_median = median(vx_scan);
        vy_median = median(vy_scan);

        vx_mean(i) = vx_median * 3.6;
        vy_mean(i) = vy_median * 3.6;
        
        v = sqrt(vx_scan.^2 + vy_scan.^2);

        v_mean(i) = median(v);
        v_mean(i) = v_mean(i)*3.6;
    end

end