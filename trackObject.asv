function objectsWithId = trackObject(objects)
    
% classify based on the scannumber: 
% clusters in subsequent frames get the same id number
threshold = 0.8;  
idNumber = 1;
objects{1}.id = idNumber; 
    
    for i = 1:length(objects)-1
        if (objects{i}.numScan +1) == objects{i+1}.numScan  
            % meanValue(1) = centerX, meanValue(2) = centerY
            distance_between_mean_values = sqrt((objects{i+1}.meanValue.centerX - objects{i}.meanValue.centerX)^2 + ...
                                               (objects{i+1}.meanValue.centerY - objects{i}.meanValue.centerY)^2);
            if distance_between_mean_values < threshold
                objects{i}.id = idNumber;
                objects{i+1}.id = idNumber;
            else
                idNumber = idNumber+1;  
                objects{i+1}.id = idNumber; 
            end
        elseif (objects{i}.numScan +2) == objects{i+1}.numScan  

            distance_between_mean_values = sqrt((objects{i+1}.meanValue.centerX - objects{i}.meanValue.centerX)^2 + ...
                                               (objects{i+1}.meanValue.centerY - objects{i}.meanValue.centerY)^2);
            if distance_between_mean_values < threshold
                objects{i}.id = idNumber;
                objects{i+1}.id = idNumber;
            else
                idNumber = idNumber+1;  
                objects{i+1}.id = idNumber; 
            end
        elseif (objects{i}.numScan +3) == objects{i+1}.numScan  

        distance_between_mean_values = sqrt((objects{i+1}.meanValue.centerX - objects{i}.meanValue.centerX)^2 + ...
                                           (objects{i+1}.meanValue.centerY - objects{i}.meanValue.centerY)^2);
            if distance_between_mean_values < threshold
                objects{i}.id = idNumber;
                objects{i+1}.id = idNumber;
            else
                idNumber = idNumber+1;  
                objects{i+1}.id = idNumber; 
        end
        else
            idNumber = idNumber+1;  
            objects{i+1}.id = idNumber;        
        end
    end

objectsWithId = objects; 
end