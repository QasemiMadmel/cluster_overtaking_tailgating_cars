function objects = classifyClusters(clusters, acceleration)

% cellfun(function, cellarray) -> anonyme function (@x x.id : take element x from cellarray and return x.id)
% Result is a vector of all id's from clusters [1, 1, 2, 2, 2, 2, 3, 4, 4, 5, ...]
% unique returns a sorted array with no repeatition of the values [1 ,2 , 3, 4, 5, ...]

ids = unique(cellfun(@(x) x.id, clusters)); % extract and sort all id's 

for n = 1:length(ids)

    currentId = ids(n);

    count = 0;
    sumLength = 0;

    % a vector of ones and zeros to keep track of direction
    direction = [];
    j = 1;

    % determine direction
    % go over all clusters
    for k = 1:length(clusters)-2

        % compare the cluster from scan 1 and one scan later (scan 3)
        if clusters{k}.id == currentId && ...
           clusters{k+2}.id == currentId

            % for the same cluster compute delta y 
            deltaY = clusters{k+2}.meanValue.centerY - ...
                     clusters{k}.meanValue.centerY;

            % if the value is negative, the point is moved toward sensor
            % over time (store 1 for true)
            if deltaY < 0
                direction(j) = 1;
            else
                direction(j) = 0; %(store 0 for moving away from sensor)
            end
            j = j + 1;
        end
    end

    % majority vote for direction 
    % (add all values in direction data for this cluster)
    sumDir = sum(direction);

    % zeros mean -> moves away, noise and wrong values are still possible
    % if the vector contains a lot of ones, the cluster is probably moving
    % toward sensor 

    if sumDir > length(direction)/4
        objects(n).approaching = true;
    else
        objects(n).approaching = false;
    end

    % store id
    objects(n).id = currentId;
    

    scannumber = clusters{k}.numscan; 
    if scannumber > 5 
        if (acceleration(scannumber) < 0 ...
                acceleration(scannumber-1) < 0 && ...
                acceleration(scannumber-2) < 0 && ...
                acceleration(scannumber-3) < 0)
            objects(n).braking = true; 
        end
    end
end
end