function arrayOfClusterObjects = clusterSegements(x_scan_points, y_scan_points)
    
    % vectorOfClusterObjects: (1.clusteredObject, 2.clusteredObject ...) 
    % clusteredObject: (1.Scannumber, 2.x_value, 3.y_value); 
    clusteredObject.numScan = []; 
    clusteredObject.x = [];
    clusteredObject.y = []; 
    clusteredObject.meanValue = [];
    clusteredObject.length = [];

    numScans = size(x_scan_points, 1); 
    numPoints = 421;
    upper_threshold = 0.3; 
    lower_threshold = 0.01; 
    segmentStarted = false; 
    lengthOfSegement = 1; 
    i = 1; j = 1;
    m = 2; 
    count = 0; 
     
    for n = 1:numScans
        for m = 2:numPoints
    
            if isnan(x_scan_points(n,m-1)) || isnan(x_scan_points(n,m))
                continue;
            end
        
            dx = x_scan_points(n,m) - x_scan_points(n,m-1);
            dy = y_scan_points(n,m) - y_scan_points(n,m-1);
       
            distance = sqrt(dx^2 + dy^2);
        
            if distance < upper_threshold && distance > lower_threshold
                segmentStarted = true; 
                count = count+1; 
                clusteredObject.numScan = n; 
                clusteredObject.x(end+1) = x_scan_points(n,m-1);
                clusteredObject.y(end+1) = y_scan_points(n,m-1);
                
            else
                if segmentStarted
                    % store matricies of different sizes in 1 cell array {}
                    centerX = mean(clusteredObject.x);
                    centerY = mean(clusteredObject.y);
                    clusteredObject.meanValue = [centerX, centerY];
                    
                    arrayOfClusterObjects{i} = clusteredObject; 
                    i = i+1; 
                    segmentStarted=false;
                    clusteredObject.numScan = []; 
                    clusteredObject.x = [];
                    clusteredObject.y =[]; 
                    clusteredObject.meanValue =[]; 
    
                end
            end
        end
        if m == numPoints
                if segmentStarted
                    centerX = mean(clusteredObject.x);
                    centerY = mean(clusteredObject.y);
                    clusteredObject.meanValue = [centerX, centerY];
                    arrayOfClusterObjects{i} = clusteredObject; 
                end
        end
    end
end