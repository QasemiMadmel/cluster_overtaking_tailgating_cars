function arrayOfSegments = clusterSegements(x_scan_points, y_scan_points)
    
    % vectorOfClusterObjects: (1.clusteredObject, 2.clusteredObject ...) 
    % clusteredObject: (1.Scannumber, 2.x_value, 3.y_value, 4.meanValue.centerX meanValue.centerY, 5.); 
   
    clusteredSegment.numScan = []; 
    clusteredSegment.x = [];
    clusteredSegment.y = []; 
    meanValue.centerX = [];
    meanValue.centerY = [];
    clusteredSegment.meanValue = [];
    clusteredSegment.length = [];

    numScans = size(x_scan_points, 1); 
    numPoints = 421;
    upper_threshold = 0.5; 
    lower_threshold = 0.005; 
    segmentStarted = false; 
    lengthOfSegement = 1; 
    i = 1; j = 1;
    m = 2; 
    count = 0; 
     
    for n = 1:numScans
        segmentStarted= false;
        for m = 2:numPoints
    
            if isnan(x_scan_points(n,m-1)) || isnan(x_scan_points(n,m))
                continue;
            end
        
            dx = x_scan_points(n,m) - x_scan_points(n,m-1);
            dy = y_scan_points(n,m) - y_scan_points(n,m-1);
       
            distance = sqrt(dx^2 + dy^2);
        
            if distance < upper_threshold && distance > lower_threshold
                segmentStarted = true; 
                count = count+1; 
                clusteredSegment.numScan = n; 
                clusteredSegment.x(end+1) = x_scan_points(n,m-1);
                clusteredSegment.y(end+1) = y_scan_points(n,m-1);
                
            else
                if segmentStarted
                    
                    center_x = mean(clusteredSegment.x);
                    center_y = mean(clusteredSegment.y);
                    clusteredSegment.meanValue.centerX = center_x;
                    clusteredSegment.meanValue.centerY = center_y;

                    lengthOfSegement = length(clusteredSegment.x);
                    clusteredSegment.length = lengthOfSegement;
                    
                    arrayOfSegments{i} = clusteredSegment; 
                    i = i+1; 
                    segmentStarted=false;
                    clusteredSegment.numScan = []; 
                    clusteredSegment.x = [];
                    clusteredSegment.y =[]; 
                    clusteredSegment.meanValue.centerX =[]; 
                    clusteredSegment.meanValue.centerY =[]; 
                    clusteredSegment.length = [];
    
                end
            end
        end
        if m == numPoints
                if segmentStarted
                    center_x = mean(clusteredSegment.x);
                    center_y = mean(clusteredSegment.y);
                    clusteredSegment.meanValue.centerX = center_x;
                    clusteredSegment.meanValue.centerY = center_y;
                    lengthOfSegement = length(clusteredSegment.x);
                    clusteredSegment.length = lengthOfSegement;
                    arrayOfSegments{i} = clusteredSegment; 
                end
        end
    end
end